FROM python:3.12-slim

USER root

# install dependencies for compilation (e.g. psycopg2)
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    curl \
    git \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p -m 0700 /root/.ssh \
    && ssh-keyscan github.com >> /root/.ssh/known_hosts

# poetry setup
ENV POETRY_VERSION=2.1.0
ENV POETRY_HOME='/usr/local'
RUN curl -sSL https://install.python-poetry.org | python3 - --version $POETRY_VERSION

WORKDIR /app

RUN poetry config virtualenvs.create false
RUN poetry config installer.max-workers 1
RUN poetry config requests.max-retries 5
RUN poetry config system-git-client true

COPY pyproject.toml poetry.lock* ./

# install dependencies with retries
RUN --mount=type=ssh poetry install --no-root --with dev --no-interaction --no-ansi -E research || \
    (echo "First attempt failed, retrying..." && poetry install --no-root --with dev --no-interaction --no-ansi -E research)

# additional libs for jupyter for testing
RUN poetry run pip install --default-timeout=600 \
    notebook \
    jupyterlab \
    jupyterlab-lsp \
    "python-lsp-server[all]" \
    jedi

# register kernel for Jupyter
RUN poetry run python -m ipykernel install \
    --name=job-parser-kernel \
    --display-name "job-parser-kernel-research (python 3.12)"
